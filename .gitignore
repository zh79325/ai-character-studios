# 日志库：含 provider 配置与 api_key，一律不进 Git（共享靠直接复制文件）
db/runtime.db
db/runtime.db-shm
db/runtime.db-wal

# 配置库本体进 Git，WAL 边文件不进
db/config.db-shm
db/config.db-wal
*.db-journal

# 环境变量与 provider 导入导出 JSON
.env
.env.*
provider_agents*.json

# 中间产物：只保留占位文件
**/tmp/*
!**/tmp/.gitkeep

