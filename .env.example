# 复制成 .env（在仓库根，不进 Git）后按需改；不配也能跑，下面全是默认值。
# 变量名一律 ATELIER_ 前缀。

# --- 远程用量服务（api-useage-server）---------------------------------------
# 同一批 api_key 会被多个工具、多台机器同时用，各记一套账就会把额度合起来打穿。
# 额度判定与扣减交给这个服务在同一事务里完成；真实 key 不外发，只发 md5 与掩码。
# 置空即不启用，完全回退本地 usage_counters 记账（单机也够用）。
ATELIER_USAGE_SERVER_URL=http://127.0.0.1:2697
ATELIER_USAGE_SERVER_TIMEOUT=2.0
# 远程连不上后多久再试一次，期间只走本地镜像，不每次白等超时
ATELIER_USAGE_SERVER_RETRY_INTERVAL=60
# 用到额度的这个比例就在日志里提醒
ATELIER_USAGE_WARN_RATIO=0.9

# --- 路由 --------------------------------------------------------------------
# 候选调用失败后跳过它多久
ATELIER_CIRCUIT_BREAKER_SECONDS=300
# 限流类失败的退避重试次数，用尽才换候选
ATELIER_PROVIDER_RETRY_ATTEMPTS=2

# --- 上下文 ------------------------------------------------------------------
ATELIER_DEFAULT_CONTEXT_BUDGET=24000
ATELIER_RECENT_TURNS=8

# --- 服务 --------------------------------------------------------------------
ATELIER_HOST=127.0.0.1
# 0 = 由系统分配空闲端口，Electron 从后端 stdout 读实际端口
ATELIER_PORT=0
